<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.canvas.Canvas?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.control.RadioButton?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.Slider?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.VBox?>

<BorderPane maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" minHeight="-Infinity" minWidth="-Infinity" prefHeight="700.0" prefWidth="1000.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="bm.erciyes.robotvacuumsim.view.MainController">
   <left>
      <VBox fx:id="leftPanel" styleClass="left-panel" prefWidth="220.0" spacing="8.0" alignment="CENTER" BorderPane.alignment="CENTER">
         <padding>
            <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
         </padding>
         <children>

            <!-- Araçlar -->
            <Label text="Araclar" style="-fx-font-weight: bold; -fx-text-fill: #aaaaff; -fx-font-size: 13px;" maxWidth="1.7976931348623157E308"/>
            <Button fx:id="addDirtButton" onAction="#onAddDirtClicked" maxWidth="1.7976931348623157E308" mnemonicParsing="false" text="Kir Ekle" />
            <Label text="Kir Turu" maxWidth="1.7976931348623157E308"/>
            <HBox spacing="8">
               <RadioButton fx:id="dustRadio" mnemonicParsing="false" text="Toz" />
               <RadioButton fx:id="liquidRadio" mnemonicParsing="false" text="Sivi" />
               <RadioButton fx:id="stainRadio" mnemonicParsing="false" text="Leke" />
            </HBox>
            <Button fx:id="addFurnitureButton" onAction="#onAddFurnitureClicked" maxWidth="1.7976931348623157E308" mnemonicParsing="false" text="Mobilya Ekle" />

            <Separator/>

            <!-- Robot Hızı -->
            <Label text="Robot Hizi" style="-fx-font-weight: bold; -fx-text-fill: #aaaaff; -fx-font-size: 13px;" maxWidth="1.7976931348623157E308"/>
            <HBox spacing="5" alignment="CENTER_LEFT" maxWidth="1.7976931348623157E308">
               <Slider fx:id="speedSlider" max="3.0" min="0.5" prefWidth="160.0" value="1.0" />
               <Label fx:id="speedLabel" text="1.0x" />
            </HBox>

            <Separator/>

            <!-- Algoritma -->
            <Label text="Temizlik Algoritmasi" style="-fx-font-weight: bold; -fx-text-fill: #aaaaff; -fx-font-size: 13px;" maxWidth="1.7976931348623157E308"/>
            <RadioButton fx:id="randomRadio" mnemonicParsing="false" text="Rastgele" maxWidth="1.7976931348623157E308"/>
            <RadioButton fx:id="spiralRadio" mnemonicParsing="false" text="Spiral" maxWidth="1.7976931348623157E308"/>
            <RadioButton fx:id="wallRadio" mnemonicParsing="false" text="Duvar Takip" maxWidth="1.7976931348623157E308"/>

            <Separator/>

            <!-- Robot Durumu -->
            <Label text="Robot Durumu" style="-fx-font-weight: bold; -fx-text-fill: #aaaaff; -fx-font-size: 13px;" maxWidth="1.7976931348623157E308"/>
            <Label fx:id="positionLabel" text="Konum: (0,0)" maxWidth="1.7976931348623157E308"/>
            <Label fx:id="directionLabel" text="Yon: Dogu" maxWidth="1.7976931348623157E308"/>
            <Label text="Batarya" maxWidth="1.7976931348623157E308"/>
            <HBox spacing="5" alignment="CENTER_LEFT">
               <ProgressBar fx:id="batteryBar" prefWidth="160.0" progress="1.0" />
               <Label fx:id="batteryLabel" text="100" />
            </HBox>

            <Separator/>

            <!-- Kontroller -->
            <Label text="Kontroller" style="-fx-font-weight: bold; -fx-text-fill: #aaaaff; -fx-font-size: 13px;" maxWidth="1.7976931348623157E308"/>
            <HBox spacing="5" maxWidth="1.7976931348623157E308">
               <Button fx:id="startButton" onAction="#onStartClicked" maxWidth="1.7976931348623157E308" mnemonicParsing="false" text="Baslat" HBox.hgrow="ALWAYS"/>
               <Button fx:id="pauseButton" onAction="#onPauseClicked" maxWidth="1.7976931348623157E308" mnemonicParsing="false" text="Duraklat" HBox.hgrow="ALWAYS"/>
            </HBox>
            <Button fx:id="resetButton" onAction="#onResetClicked" maxWidth="1.7976931348623157E308" mnemonicParsing="false" text="Sifirla" />
            <Button fx:id="returnButton" onAction="#onReturnClicked" maxWidth="1.7976931348623157E308" mnemonicParsing="false" text="Istasyona Don" />

            <!-- Alt boşluk doldurucu -->
            <Pane VBox.vgrow="ALWAYS"/>
            <Separator/>
            <Label text="Simulasyon - JavaFX Projesi"
                   style="-fx-text-fill: #555577; -fx-font-size: 11px;"
                   maxWidth="1.7976931348623157E308"
                   alignment="CENTER"/>

         </children>
      </VBox>
   </left>
   <center>
      <Pane fx:id="canvasPane" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" BorderPane.alignment="CENTER">
         <Canvas fx:id="roomCanvas"/>
      </Pane>
   </center>
   <bottom>
      <HBox styleClass="bottom-bar" alignment="CENTER" prefHeight="60.0" spacing="30.0" BorderPane.alignment="CENTER">
         <padding>
            <Insets bottom="10.0" left="20.0" right="20.0" top="10.0" />
         </padding>
         <children>
            <VBox alignment="CENTER" spacing="3">
               <Label text="Toplam Alan" style="-fx-text-fill: #3498db; -fx-font-weight: bold;"/>
               <Label fx:id="totalAreaLabel" text="280 hucre"/>
            </VBox>
            <VBox alignment="CENTER" spacing="3">
               <Label text="Temizlenen Alan" style="-fx-text-fill: #2ecc71; -fx-font-weight: bold;"/>
               <Label fx:id="cleanedLabel" text="0 hucre (0%)"/>
            </VBox>
            <VBox alignment="CENTER" spacing="3">
               <Label text="Kalan Alan" style="-fx-text-fill: #e74c3c; -fx-font-weight: bold;"/>
               <Label fx:id="remainingLabel" text="280 hucre (100%)"/>
            </VBox>
            <VBox alignment="CENTER" spacing="3">
               <Label text="Gecen Sure" style="-fx-font-weight: bold; -fx-text-fill: #aaaaff;"/>
               <Label fx:id="timeLabel" text="00:00"/>
            </VBox>
            <VBox alignment="CENTER" spacing="3">
               <Label text="Toplanan Toz" style="-fx-font-weight: bold; -fx-text-fill: #aaaaff;"/>
               <Label fx:id="dirtLabel" text="0"/>
            </VBox>
         </children>
      </HBox>
   </bottom>
</BorderPane>